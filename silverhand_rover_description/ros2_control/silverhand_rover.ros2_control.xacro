<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="silverhand_rover_ros2_control"
    params="name initial_positions_file use_mock_hardware:=true can_iface:=vcan1 node_id:=110 queue_len:=1000">
    <xacro:property
      name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <xacro:property
      name="use_mock_hardware_bool"
      value="${str(use_mock_hardware).lower() in ['true', '1', 'yes']}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware_bool}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware_bool}">
          <plugin>silverhand_rover_hardware/SilverhandRoverSystem</plugin>
          <param name="can_iface">${can_iface}</param>
          <param name="node_id">${node_id}</param>
          <param name="queue_len">${queue_len}</param>
        </xacro:unless>
      </hardware>

      <joint name="left_front_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_front_wheel_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_middle_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_middle_wheel_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_rear_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_rear_wheel_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_front_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_front_wheel_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_middle_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_middle_wheel_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_rear_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_rear_wheel_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
